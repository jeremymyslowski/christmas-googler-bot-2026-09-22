---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { landscape } from "../data/content";
import { site, hours } from "../data/site";
---
<BaseLayout
  title="Landscape Trees"
  description="Balled and burlapped evergreen and deciduous landscape trees from Helen & Ed's Tree Farm. Delivery, planting, and certified arborist consulting."
>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-maple)]">Landscape nursery</p>
      <h1 class="mt-2 font-display text-4xl text-[var(--color-forest)] sm:text-5xl">Evergreens & deciduous for your property</h1>
      <p class="mt-4 max-w-3xl text-lg text-[var(--color-muted)]">{landscape.intro}</p>
      <p class="mt-3 text-sm font-medium text-[var(--color-charcoal)]">{hours.landscape.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`tel:${site.phones.ed.tel}`}>Call Ed {site.phones.ed.display}</Button>
        <Button href="/inventory" variant="secondary">View inventory / prices</Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-10">
    <div class="mx-auto max-w-md md:mx-0 md:max-w-lg">
      <!-- TEMP placeholder -->
      <figure class="snapshot snapshot--tilt-right">
        <img
          src="/photos/landscape-path.jpg"
          alt="Landscape evergreen nursery stock"
          class="aspect-[4/3] w-full object-cover"
          width="800"
          height="600"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="font-display text-3xl text-[var(--color-forest)]">Evergreen</h2>
    <p class="mt-1 text-sm text-[var(--color-muted)]">{landscape.evergreen.sizeNote}</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        landscape.evergreen.groups.map((g) => (
          <div class="rounded-2xl border border-[var(--color-border)] bg-white p-5">
            <h3 class="font-display text-xl text-[var(--color-forest)]">{g.label}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{g.items.join(" · ")}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-[var(--color-border)] bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="font-display text-3xl text-[var(--color-forest)]">Deciduous</h2>
      <p class="mt-1 text-sm text-[var(--color-muted)]">{landscape.deciduous.sizeNote}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          landscape.deciduous.groups.map((g) => (
            <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-cream)] p-5">
              <h3 class="font-display text-xl text-[var(--color-forest)]">{g.label}</h3>
              <p class="mt-2 text-sm text-[var(--color-muted)]">{g.items.join(" · ")}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-[var(--color-muted)]">
        See the <a class="font-semibold text-[var(--color-forest)] underline" href="/inventory">Spring 2026 B&B price list</a> for current sizes and prices. Orders by phone or email only.
      </p>
    </div>
  </section>
</BaseLayout>
