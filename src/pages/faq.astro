---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { faqs } from "../data/content";
---
<BaseLayout title="FAQ" description="Frequently asked questions about Christmas trees and planting at Helen & Ed's Tree Farm.">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-display text-4xl text-[var(--color-forest)]">Frequently asked questions</h1>
    <p class="mt-3 text-[var(--color-muted)]">A short selection from our farm FAQ. Call with anything else.</p>
    <div class="mt-8 space-y-4">
      {
        faqs.map((f) => (
          <details class="rounded-xl border border-[var(--color-border)] bg-white p-4">
            <summary class="cursor-pointer font-semibold text-[var(--color-forest)]">{f.q}</summary>
            <p class="mt-3 text-sm text-[var(--color-muted)]">{f.a}</p>
          </details>
        ))
      }
    </div>
    <div class="mt-8">
      <Button href="/contact">Contact us</Button>
    </div>
  </section>
</BaseLayout>
