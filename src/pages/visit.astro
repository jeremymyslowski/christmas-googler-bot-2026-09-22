---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { directions } from "../data/directions";
import { site, hours } from "../data/site";
---
<BaseLayout
  title="Directions & Hours"
  description="Driving directions from I-81 and seasonal hours for Helen & Ed's Tree Farm in Wapwallopen, PA."
>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h1 class="font-display text-4xl text-[var(--color-forest)] sm:text-5xl">Visit us</h1>
      <address class="mt-4 not-italic text-lg text-[var(--color-muted)]">
        {site.name}<br />
        {site.address.street}<br />
        {site.address.city}, {site.address.state} {site.address.zip}
      </address>
      <p class="mt-2 text-sm text-[var(--color-muted)]">{directions.note}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`tel:${site.phones.office.tel}`}>Office {site.phones.office.display}</Button>
        <Button href={`tel:${site.phones.ed.tel}`} variant="secondary">Ed {site.phones.ed.display}</Button>
        <Button
          href={`https://www.google.com/maps/search/?api=1&query=${site.geo.lat},${site.geo.lng}`}
          variant="ghost"
        >
          Open in Maps
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="font-display text-3xl text-[var(--color-forest)]">Hours</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-5">
        <h3 class="font-display text-xl text-[var(--color-forest)]">{hours.christmas.label}</h3>
        <p class="mt-2 text-[var(--color-muted)]">{hours.christmas.summary}</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">{hours.christmas.detail}</p>
      </div>
      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-5">
        <h3 class="font-display text-xl text-[var(--color-forest)]">{hours.landscape.label}</h3>
        <p class="mt-2 text-[var(--color-muted)]">{hours.landscape.summary}</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">{hours.landscape.detail}</p>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)] bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="font-display text-3xl text-[var(--color-forest)]">Driving directions</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        {
          [directions.fromNorth, directions.fromSouth].map((block) => (
            <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-cream)] p-6">
              <h3 class="font-display text-2xl text-[var(--color-forest)]">{block.title}</h3>
              <ol class="mt-4 list-decimal space-y-2 pl-5 text-[var(--color-muted)]">
                {block.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <!-- TEMP placeholder -->
        <figure class="snapshot snapshot--tilt overflow-hidden rounded-xl">
          <img
            src="/photos/barn-visit.jpg"
            alt="Rural barn and hillside — park by the big green barn"
            class="h-56 w-full object-cover sm:h-64"
            width="1200"
            height="640"
            loading="lazy"
          />
        </figure>
        <p class="mt-3 text-sm text-[var(--color-muted)]">
          Farm location · <span class="tabular-nums">{site.geo.lat}, {site.geo.lng}</span> · Park by the big green barn.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
