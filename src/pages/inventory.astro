---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import inventory from "../data/inventory.json";
import { site } from "../data/site";

function formatPrice(n: number) {
  return `$${n.toFixed(2)}`;
}
---
<BaseLayout
  title="Inventory / Prices"
  description="Spring 2026 balled and burlapped price list from Helen & Ed's Tree Farm. Display only — call or email to order."
>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-maple)]">{inventory.seasonLabel}</p>
      <h1 class="mt-2 font-display text-4xl text-[var(--color-forest)] sm:text-5xl">{inventory.title}</h1>
      <p class="mt-4 max-w-3xl text-[var(--color-muted)]">{inventory.intro}</p>
      <p class="mt-3 text-sm text-[var(--color-charcoal)]">{inventory.contactNote}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`tel:${site.phones.office.tel}`}>Office {site.phones.office.display}</Button>
        <Button href={`tel:${site.phones.ed.tel}`} variant="secondary">Ed {site.phones.ed.display}</Button>
        <Button href={`mailto:${site.email}`} variant="ghost">Email {site.email}</Button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl space-y-10 px-4 py-12">
    {
      inventory.categories.map((cat) => (
        <div>
          <h2 class="font-display text-2xl text-[var(--color-forest)]">{cat.name}</h2>
          <div class="mt-4 overflow-x-auto rounded-2xl border border-[var(--color-border)] bg-white">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-[var(--color-cream-dark)] text-[var(--color-forest)]">
                <tr>
                  <th class="px-4 py-3 font-semibold">Plant</th>
                  <th class="px-4 py-3 font-semibold">Size</th>
                  <th class="px-4 py-3 font-semibold">Price</th>
                  <th class="px-4 py-3 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody>
                {cat.items.flatMap((item) =>
                  item.sizes.map((sz, idx) => (
                    <tr class:list={["border-t border-[var(--color-border)]", item.soldOut && "bg-[var(--color-cream)]/60"]}>
                      <td class="px-4 py-3 font-medium text-[var(--color-charcoal)]">
                        {idx === 0 ? item.name : ""}
                        {idx === 0 && item.soldOut ? (
                          <span class="ml-2 rounded-full bg-[var(--color-berry)] px-2 py-0.5 text-xs font-semibold text-white">
                            Sold out 2026
                          </span>
                        ) : null}
                      </td>
                      <td class="px-4 py-3 text-[var(--color-muted)]">{sz.size}</td>
                      <td class="px-4 py-3 tabular-nums text-[var(--color-charcoal)]">{formatPrice(sz.price)}</td>
                      <td class="px-4 py-3 text-[var(--color-muted)]">{idx === 0 ? item.notes ?? "" : ""}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
    <p class="rounded-xl border border-[var(--color-border)] bg-[var(--color-cream-dark)] p-4 text-sm text-[var(--color-muted)]">
      This list is informational. Availability changes — confirm by phone or email before visiting. No online cart or reservations.
    </p>
  </section>
</BaseLayout>
