---
interface Props {
  steps: { title: string; body: string }[];
  heading?: string;
}
const { steps, heading = "How it works" } = Astro.props;
---
<section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="steps-heading">
  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-paper)] p-6 sm:p-8">
    <h2 id="steps-heading" class="font-display text-3xl text-[var(--color-needle)] sm:text-4xl">
      {heading}
    </h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="rounded-xl border border-[var(--color-border)] bg-[var(--color-paper-dark)]/40 p-5">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-moss)] text-sm font-bold text-[var(--color-snow)]">
              {i + 1}
            </div>
            <h3 class="font-display text-xl text-[var(--color-needle)]">{step.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
