---
import type { Season } from "../data/seasons";
import { seasonCopy } from "../data/seasons";

interface Props {
  season: Season;
  class?: string;
}
const { season, class: className = "" } = Astro.props;
const copy = seasonCopy[season];
---
<span
  data-season-chip
  class={`season-chip inline-flex items-center gap-2 rounded-lg border px-3 py-1 text-sm font-medium ${className}`}
>
  <span
    class="h-2 w-2 rounded-full"
    style={`background: var(--color-cta)`}
    aria-hidden="true"
  ></span>
  <span data-season-chip-label>{copy.chip}</span>
</span>
