---
import { site, nav } from "../data/site";
import type { Season } from "../data/seasons";
import SeasonChip from "./SeasonChip.astro";

interface Props {
  season: Season;
}
const { season } = Astro.props;
const path = Astro.url.pathname;
---
<header class="relative z-40">
  <!-- Brand strip: paper + logo + wordmark -->
  <div class="border-b border-[var(--color-border)] bg-[var(--color-paper)]">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href="/" class="group flex min-w-0 items-center gap-3">
        <img
          src="/brand/logo.svg"
          alt=""
          width="48"
          height="48"
          class="h-11 w-11 shrink-0 sm:h-12 sm:w-12"
        />
        <span class="min-w-0">
          <span class="font-display block truncate text-xl font-semibold text-[var(--color-needle)] sm:text-2xl">
            {site.name}
          </span>
          <span class="block text-xs italic text-[var(--color-ink-muted)] sm:text-sm">
            Since {site.since} · {site.tagline}
          </span>
        </span>
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] px-3 py-2 text-sm font-semibold text-[var(--color-needle)]">
          Menu
        </summary>
        <div class="absolute right-0 z-50 mt-2 w-60 rounded-xl border border-[var(--color-border)] bg-[var(--color-paper)] p-2 shadow-lg">
          <SeasonChip season={season} class="mb-2 w-full justify-center" />
          <ul class="site-nav-mobile flex flex-col">
            {
              nav.map((item) => {
                const active = path === item.href || (item.href !== "/" && path.startsWith(item.href));
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        "site-nav-link-mobile block rounded-lg px-3 py-2 text-sm font-medium transition",
                        active && "is-active",
                      ]}
                      aria-current={active ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </details>
    </div>
  </div>
  <!-- Desktop nav row: bark -->
  <nav class="site-nav hidden border-b border-[var(--color-bark-mid)] bg-[var(--color-bark)] lg:block" aria-label="Primary">
    <ul class="mx-auto flex max-w-6xl items-center gap-1 px-4 py-2">
      {
        nav.map((item) => {
          const active = path === item.href || (item.href !== "/" && path.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "site-nav-link rounded-lg px-3 py-2 text-sm font-medium transition",
                  active && "is-active",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
