---
interface Props {
  href: string;
  title: string;
  eyebrow: string;
  body: string;
  cta: string;
  tone?: "christmas" | "landscape";
  image: string;
  imageAlt: string;
}
const { href, title, eyebrow, body, cta, tone = "christmas", image, imageAlt } = Astro.props;
const accent = tone === "christmas" ? "var(--color-berry)" : "var(--color-maple)";
const tilt = tone === "christmas" ? "snapshot--tilt" : "snapshot--tilt-right";
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-paper)] shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div class="p-3 pb-0">
    <!-- TEMP placeholder -->
    <figure class={`snapshot ${tilt} overflow-hidden`}>
      <img src={image} alt={imageAlt} class="h-40 w-full object-cover" width="600" height="320" loading="lazy" />
    </figure>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-xs font-semibold uppercase tracking-wider" style={`color: ${accent}`}>{eyebrow}</p>
    <h3 class="font-display text-2xl text-[var(--color-needle)]">{title}</h3>
    <p class="flex-1 text-[var(--color-ink-muted)]">{body}</p>
    <span class="text-sm font-semibold" style={`color: ${accent}`}>{cta} →</span>
  </div>
</a>
